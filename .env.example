# ---------------------------------------------------------------
# Copy to .env and fill in.  cp .env.example .env
# .env is gitignored; .env.example must never contain real values.
# ---------------------------------------------------------------

# --- PRODUCTION: encrypted client store -------------------------
# Railway Postgres provides this automatically once the database is
# attached to the service. When set, clients are loaded from Postgres
# and clients.json is ignored entirely.
DATABASE_URL=

# 32 random bytes, base64. REQUIRED whenever DATABASE_URL is set.
# Generate with:
#   python3 -c "import crypto_store; print(crypto_store.generate_master_key())"
# Losing this makes every stored API key unrecoverable. Never commit it.
KLAVIYO_MASTER_KEY=

# --- n8n (optional) ---------------------------------------------
# Leave empty and `python3 index.py` still checks every account and prints
# the full summary; it just skips webhook delivery.
# Use the production path (/webhook/), not the editor path (/webhook-test/).
N8N_WEBHOOK_URL=

# per_client (default) = one POST per client | batch = one POST with all clients
N8N_SEND_MODE=per_client

# --- LOCAL DEVELOPMENT ONLY -------------------------------------
# Used only when DATABASE_URL is empty. Never needed in Railway.
KLAVIYO_CLIENTS_FILE=clients.json

# --- Reminder tuning --------------------------------------------
# A core metric (profiles/email/SMS) at or above this alerts once per billing period
USAGE_ALERT_PERCENT=95

# --- Throughput -------------------------------------------------
MAX_WORKERS=6

# Only enable if every client key has the campaigns:write scope
USE_ESTIMATION_FALLBACK=false

# --- Duplicate alert suppression --------------------------------
# With DATABASE_URL set, history lives in Postgres and ALERT_STATE_FILE
# is unused (no Railway volume needed).
ALERT_STATE_FILE=.alert_state.json
ALERT_COOLDOWN_HOURS=168
ALERT_STATE_RETENTION_DAYS=90
